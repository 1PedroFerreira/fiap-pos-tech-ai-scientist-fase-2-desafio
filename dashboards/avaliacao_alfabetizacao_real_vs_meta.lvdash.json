{
  "datasets": [
    {
      "name": "alunos",
      "displayName": "Alfabetização — Alunos",
      "config": {
        "source": "workspace.default.gold_alunos",
        "measures": [
          {
            "name": "qtd_alunos",
            "expr": "COUNT(1)"
          },
          {
            "name": "taxa_alfabetizacao",
            "expr": "AVG(CASE WHEN alfabetizado THEN 1.0 ELSE 0.0 END)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "escolas_avaliadas",
            "expr": "COUNT(DISTINCT id_escola)"
          },
          {
            "name": "municipios_avaliados",
            "expr": "COUNT(DISTINCT id_municipio)"
          },
          {
            "name": "media_leitura",
            "expr": "AVG(proficiencia_leitura)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "media_escrita",
            "expr": "AVG(proficiencia_escrita)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "media_matematica",
            "expr": "AVG(proficiencia_matematica)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Avaliações por aluno com nome de município e UF (dados simulados INEP)",
        "dimensions": [
          {
            "name": "ano",
            "expr": "ano"
          },
          {
            "name": "id_aluno",
            "expr": "id_aluno"
          },
          {
            "name": "id_escola",
            "expr": "id_escola"
          },
          {
            "name": "id_municipio",
            "expr": "id_municipio"
          },
          {
            "name": "nome_municipio",
            "expr": "nome_municipio"
          },
          {
            "name": "sigla_uf",
            "expr": "sigla_uf"
          },
          {
            "name": "nome_uf",
            "expr": "nome_uf"
          },
          {
            "name": "regiao",
            "expr": "regiao"
          },
          {
            "name": "rede",
            "expr": "rede"
          },
          {
            "name": "serie",
            "expr": "serie"
          },
          {
            "name": "idade",
            "expr": "idade"
          },
          {
            "name": "nivel_escrita",
            "expr": "nivel_escrita"
          },
          {
            "name": "alfabetizado",
            "expr": "alfabetizado"
          },
          {
            "name": "situacao_aluno",
            "expr": "CASE WHEN alfabetizado THEN 'Alfabetizado' ELSE 'Não alfabetizado' END"
          },
          {
            "name": "data_avaliacao",
            "expr": "data_avaliacao"
          },
          {
            "name": "proficiencia_leitura",
            "expr": "proficiencia_leitura"
          },
          {
            "name": "proficiencia_escrita",
            "expr": "proficiencia_escrita"
          },
          {
            "name": "proficiencia_matematica",
            "expr": "proficiencia_matematica"
          }
        ]
      }
    },
    {
      "name": "alfabetizacao_brasil",
      "displayName": "Alfabetização — Brasil",
      "config": {
        "source": "workspace.default.gold_alfabetizacao_brasil",
        "measures": [
          {
            "name": "qtd_alunos",
            "expr": "SUM(qtd_alunos)"
          },
          {
            "name": "pct_alfabetizados",
            "expr": "AVG(pct_alfabetizados)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "meta_pct",
            "expr": "AVG(meta_pct)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "atingimento_meta",
            "expr": "AVG(atingimento_meta)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Taxa de alfabetização real por ano comparada à meta nacional (dados simulados INEP)",
        "dimensions": [
          {
            "name": "ano",
            "expr": "ano"
          }
        ]
      }
    },
    {
      "name": "alfabetizacao_municipio",
      "displayName": "Alfabetização — Município",
      "config": {
        "source": "workspace.default.gold_alfabetizacao_municipio",
        "measures": [
          {
            "name": "qtd_alunos",
            "expr": "SUM(qtd_alunos)"
          },
          {
            "name": "pct_alfabetizados",
            "expr": "AVG(pct_alfabetizados)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "meta_pct",
            "expr": "AVG(meta_pct)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "atingimento_meta",
            "expr": "AVG(atingimento_meta)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "atingimento_ponderado",
            "expr": "SUM(atingimento_meta * qtd_alunos) / SUM(qtd_alunos)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Taxa de alfabetização real por município e ano comparada à meta municipal (dados simulados INEP)",
        "dimensions": [
          {
            "name": "ano",
            "expr": "ano"
          },
          {
            "name": "id_municipio",
            "expr": "id_municipio"
          },
          {
            "name": "nome_municipio",
            "expr": "nome_municipio"
          },
          {
            "name": "sigla_uf",
            "expr": "sigla_uf"
          },
          {
            "name": "nome_uf",
            "expr": "nome_uf"
          },
          {
            "name": "regiao",
            "expr": "regiao"
          },
          {
            "name": "municipio_uf",
            "expr": "concat(nome_municipio, ' (', sigla_uf, ')')"
          },
          {
            "name": "meta_atingida",
            "expr": "meta_atingida"
          },
          {
            "name": "situacao_meta",
            "expr": "CASE WHEN meta_atingida THEN 'Meta atingida' ELSE 'Abaixo da meta' END"
          }
        ]
      }
    },
    {
      "name": "alfabetizacao_uf",
      "displayName": "Alfabetização — UF",
      "config": {
        "source": "workspace.default.gold_alfabetizacao_uf",
        "measures": [
          {
            "name": "qtd_alunos",
            "expr": "SUM(qtd_alunos)"
          },
          {
            "name": "qtd_avaliacoes",
