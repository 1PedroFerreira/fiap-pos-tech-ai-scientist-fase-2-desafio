          },
          {
            "name": "pct_alfabetizados",
            "expr": "AVG(pct_alfabetizados)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "meta_pct",
            "expr": "AVG(meta_pct)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "pct_alfabetizados_ponderado",
            "expr": "SUM(pct_alfabetizados * qtd_alunos) / SUM(qtd_alunos)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "meta_pct_ponderado",
            "expr": "SUM(meta_pct * qtd_alunos) / SUM(qtd_alunos)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "atingimento_meta",
            "expr": "AVG(atingimento_meta)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "atingimento_ponderado",
            "expr": "SUM(atingimento_meta * qtd_alunos) / SUM(qtd_alunos)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Taxa de alfabetização real por UF e ano comparada à meta estadual (dados simulados INEP)",
        "dimensions": [
          {
            "name": "ano",
            "expr": "ano"
          },
          {
            "name": "sigla_uf",
            "expr": "sigla_uf"
          },
          {
            "name": "nome_uf",
            "expr": "nome_uf"
          },
          {
            "name": "regiao",
            "expr": "regiao"
          },
          {
            "name": "meta_atingida",
            "expr": "meta_atingida"
          },
          {
            "name": "situacao_meta",
            "expr": "CASE WHEN meta_atingida THEN 'Meta atingida' ELSE 'Abaixo da meta' END"
          }
        ]
      }
    }
